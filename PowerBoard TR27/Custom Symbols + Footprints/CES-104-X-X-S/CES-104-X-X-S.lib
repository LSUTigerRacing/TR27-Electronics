DEF CES-104-X-X-S J 0 40 Y Y 1 L N
F0 "J" -200 230 50 H V L BNN
F1 "CES-104-X-X-S" -200 -400 50 H V L BNN
F2 "SAMTEC_CES-104-X-X-S" 0 0 50 H I L BNN
F3 "" 0 0 50 H I L BNN
F4 "A" 0 0 50 H I L BNN "PARTREV"
F5 "Manufacturer Recommendations" 0 0 50 H I L BNN "STANDARD"
F6 "5.08 mm" 0 0 50 H I L BNN "MAXIMUM_PACKAGE_HEIGHT"
F7 "Samtec" 0 0 50 H I L BNN "MANUFACTURER"
DRAW
S -200 -300 200 200 0 0 10 f
X 01 01 -400 100 200 R 40 40 0 0 P 
X 02 02 -400 0 200 R 40 40 0 0 P 
X 03 03 -400 -100 200 R 40 40 0 0 P 
X 04 04 -400 -200 200 R 40 40 0 0 P 
ENDDRAW
